{
  "name": "project-dashboard-vue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "vite": "vite",
    "server": "node server/server.js",
    "python-setup": "python3 -m venv .venv || python -m venv .venv && (.venv/Scripts/pip install edge-tts || .venv/bin/pip install edge-tts)",
    
